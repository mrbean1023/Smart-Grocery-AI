# Dependencies (re-installed inside the image)
node_modules
**/node_modules

# Build output (rebuilt inside the image)
dist
**/dist
.next
**/.next
out
**/out
*.tsbuildinfo

# VCS
.git
.gitignore

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Test artifacts
coverage
**/coverage

# Infra that has no business in an app image
infra/terraform
infra/k8s

# Misc
*.log
.DS_Store
Thumbs.db
.idea
.vscode
