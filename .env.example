# ==============================================================
# Smart Grocery AI Singapore — Environment Template
# Copy to .env and fill in values. Never commit .env.
# ==============================================================

# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---- Database (PostgreSQL + pgvector) ----
DATABASE_URL=postgresql://grocery:grocery_dev_password@localhost:5432/smart_grocery?schema=public
POSTGRES_USER=grocery
POSTGRES_PASSWORD=grocery_dev_password
POSTGRES_DB=smart_grocery

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Elasticsearch ----
ELASTICSEARCH_NODE=http://localhost:9200

# ---- Auth ----
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_nextauth_secret

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Google Cloud Vision (OCR) ----
# Path to service-account JSON, or leave blank to use OpenAI vision fallback
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# ---- AWS / S3 ----
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=smart-grocery-uploads
# For local dev, MinIO from docker-compose:
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ---- Stripe ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Email (SMTP — Mailhog in dev) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Grocery AI <noreply@smartgrocery.sg>

# ---- Monitoring ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ---- Feature flags ----
FREEMIUM_ENFORCED=true
FREE_TIER_SCANS_PER_MONTH=5
FREE_TIER_OPTIMIZATIONS_PER_DAY=1
